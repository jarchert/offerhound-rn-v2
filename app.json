{
  "expo": {
    "name": "OfferHound",
    "slug": "offerhound-v2",
    "scheme": "offerhoundv2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101318"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergentmindlab.offerhoundv2",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "OfferHound needs camera access to upload profile photos and highlight videos.",
        "NSPhotoLibraryUsageDescription": "OfferHound needs photo library access to upload profile photos and highlight videos.",
        "NSPhotoLibraryAddUsageDescription": "OfferHound saves share cards and highlight images to your photo library.",
        "NSMicrophoneUsageDescription": "OfferHound needs microphone access for video recording.",
        "NSCalendarsUsageDescription": "OfferHound adds upcoming college camps and recruiting events to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "OfferHound adds upcoming college camps and recruiting events to your calendar.",
        "NSUserTrackingUsageDescription": "OfferHound never tracks you across other apps. This permission is unused.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.emergentmindlab.offerhoundv2",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101318"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "offerhound.app"
            },
            {
              "scheme": "https",
              "host": "www.offerhound.app"
            },
            {
              "scheme": "https",
              "host": "playbook-promoter.lovable.app"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/football"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/basketball"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/soccer"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/baseball"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/softball"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/volleyball"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/lacrosse"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/hockey"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/swimming"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/golf"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/track-field"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/cheerleading"
            },
            {
              "scheme": "https",
              "host": "offerhound.app",
              "pathPrefix": "/wrestling"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e7af08"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OfferHound accesses your photos to let you upload profile and highlight media.",
          "cameraPermission": "OfferHound uses your camera to capture profile photos and videos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "OfferHound adds upcoming camps to your calendar."
        }
      ],
      "expo-secure-store",
      "expo-tracking-transparency",
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "@react-native-google-signin/google-signin",
      "./plugins/with-app-clip",
      "./plugins/with-widgets",
      "./plugins/with-live-activities",
    ],
    "extra": {
      "eas": {
        "projectId": "061531bc-07d8-4533-8356-023ad2be58f2"
      }
    },
    "owner": "jarchert"
  }
}
